# --- Qloo -------------------------------------------------------------
# live = real Qloo calls (falls back to recorded fixtures on failure)
# recorded = replay fixtures/recorded/recorded.json only
# mock = hand-written sample data (UI shows "Sample data, not live Qloo")
# Default when unset: mock locally, live on Vercel.
QLOO_MODE=mock
QLOO_API_KEY=
# The hackathon key only works on this host.
QLOO_BASE_URL=https://hackathon.api.qloo.com
# Soft per-instance monthly call budget (serverless memory is not durable).
QLOO_MONTHLY_BUDGET=8000

# --- LLM (free tier) ---------------------------------------------------
# gemini | groq | openrouter
LLM_PROVIDER=gemini
LLM_API_KEY=
# Optional override. Defaults: gemini-3.8-flash | openai/gpt-oss-120b | meta-llama/llama-3.3-70b-instruct:free
LLM_MODEL=

# --- Abuse protection ----------------------------------------------------
# Requests per minute per IP on /api/session and /api/compare.
RATE_LIMIT_PER_MIN=20
